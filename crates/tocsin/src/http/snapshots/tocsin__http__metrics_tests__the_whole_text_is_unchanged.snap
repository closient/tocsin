# HELP tocsin_build_info Always 1; the version label is the running tocsin's.
# TYPE tocsin_build_info gauge
tocsin_build_info{version="<version>"} 1
# HELP tocsin_check_up Each check's and heartbeat's confirmed health: 1 up, 0.5 degraded, 0 down; absent until confirmed.
# TYPE tocsin_check_up gauge
tocsin_check_up{check="api-https",component="api",node="node-a",kind="check"} 0.0
tocsin_check_up{check="backup",component="jobs",node="node-a",kind="heartbeat"} 1.0
# HELP tocsin_check_last_run_timestamp When each check's latest probe started, in unix seconds.
# TYPE tocsin_check_last_run_timestamp gauge
tocsin_check_last_run_timestamp{check="api-https",component="api",node="node-a"} 1760000060
tocsin_check_last_run_timestamp{check="db",component="",node="node-a"} 1760000061
# HELP tocsin_heartbeat_last_ping_timestamp When each heartbeat was last pinged, in unix seconds; absent until its first ping since tocsin started.
# TYPE tocsin_heartbeat_last_ping_timestamp gauge
tocsin_heartbeat_last_ping_timestamp{check="backup",component="jobs",node="node-a"} 1760000030
# HELP tocsin_component_status 1 for the status each component shows on the status page, 0 for the others.
# TYPE tocsin_component_status gauge
tocsin_component_status{component="api",node="node-a",status="degraded"} 0
tocsin_component_status{component="api",node="node-a",status="down"} 1
tocsin_component_status{component="api",node="node-a",status="maintenance"} 0
tocsin_component_status{component="api",node="node-a",status="operational"} 0
tocsin_component_status{component="api",node="node-a",status="unknown"} 0
tocsin_component_status{component="jobs",node="node-a",status="degraded"} 0
tocsin_component_status{component="jobs",node="node-a",status="down"} 0
tocsin_component_status{component="jobs",node="node-a",status="maintenance"} 1
tocsin_component_status{component="jobs",node="node-a",status="operational"} 0
tocsin_component_status{component="jobs",node="node-a",status="unknown"} 0
# HELP tocsin_db_size_bytes The database's size on disk, its write-ahead log included.
# TYPE tocsin_db_size_bytes gauge
tocsin_db_size_bytes <size>
