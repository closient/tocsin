---
source: crates/tocsin/src/http/metrics_tests.rs
expression: normalized(&api.metrics().await)
---
# HELP tocsin_notification_failures_total Failed attempts to deliver an alert message, retried or not, by notifier.
# TYPE tocsin_notification_failures_total counter
tocsin_notification_failures_total{notifier="pager"} 1
# HELP tocsin_notifications_abandoned_total Alert messages given up on after their last attempt failed, by notifier.
# TYPE tocsin_notifications_abandoned_total counter
tocsin_notifications_abandoned_total{notifier="pager"} 1
# HELP tocsin_config_reload_success 1 if the last configuration reload succeeded, 0 if it failed and the last good configuration is still running.
# TYPE tocsin_config_reload_success gauge
tocsin_config_reload_success 1
# HELP tocsin_config_last_error_timestamp When a configuration reload last failed, in unix seconds; 0 if none has.
# TYPE tocsin_config_last_error_timestamp gauge
tocsin_config_last_error_timestamp 0
# HELP tocsin_check_duration_seconds How long each check's probes take.
# TYPE tocsin_check_duration_seconds histogram
tocsin_check_duration_seconds_sum{check="api-https",component="api",node="node-a"} 0.12
tocsin_check_duration_seconds_count{check="api-https",component="api",node="node-a"} 1
tocsin_check_duration_seconds_bucket{le="0.005",check="api-https",component="api",node="node-a"} 0
tocsin_check_duration_seconds_bucket{le="0.01",check="api-https",component="api",node="node-a"} 0
tocsin_check_duration_seconds_bucket{le="0.025",check="api-https",component="api",node="node-a"} 0
tocsin_check_duration_seconds_bucket{le="0.05",check="api-https",component="api",node="node-a"} 0
tocsin_check_duration_seconds_bucket{le="0.1",check="api-https",component="api",node="node-a"} 0
tocsin_check_duration_seconds_bucket{le="0.25",check="api-https",component="api",node="node-a"} 1
tocsin_check_duration_seconds_bucket{le="0.5",check="api-https",component="api",node="node-a"} 1
tocsin_check_duration_seconds_bucket{le="1.0",check="api-https",component="api",node="node-a"} 1
tocsin_check_duration_seconds_bucket{le="2.5",check="api-https",component="api",node="node-a"} 1
tocsin_check_duration_seconds_bucket{le="5.0",check="api-https",component="api",node="node-a"} 1
tocsin_check_duration_seconds_bucket{le="10.0",check="api-https",component="api",node="node-a"} 1
tocsin_check_duration_seconds_bucket{le="30.0",check="api-https",component="api",node="node-a"} 1
tocsin_check_duration_seconds_bucket{le="60.0",check="api-https",component="api",node="node-a"} 1
tocsin_check_duration_seconds_bucket{le="+Inf",check="api-https",component="api",node="node-a"} 1
tocsin_check_duration_seconds_sum{check="db",component="",node="node-a"} 0.004
tocsin_check_duration_seconds_count{check="db",component="",node="node-a"} 1
tocsin_check_duration_seconds_bucket{le="0.005",check="db",component="",node="node-a"} 1
tocsin_check_duration_seconds_bucket{le="0.01",check="db",component="",node="node-a"} 1
tocsin_check_duration_seconds_bucket{le="0.025",check="db",component="",node="node-a"} 1
tocsin_check_duration_seconds_bucket{le="0.05",check="db",component="",node="node-a"} 1
tocsin_check_duration_seconds_bucket{le="0.1",check="db",component="",node="node-a"} 1
tocsin_check_duration_seconds_bucket{le="0.25",check="db",component="",node="node-a"} 1
tocsin_check_duration_seconds_bucket{le="0.5",check="db",component="",node="node-a"} 1
tocsin_check_duration_seconds_bucket{le="1.0",check="db",component="",node="node-a"} 1
tocsin_check_duration_seconds_bucket{le="2.5",check="db",component="",node="node-a"} 1
tocsin_check_duration_seconds_bucket{le="5.0",check="db",component="",node="node-a"} 1
tocsin_check_duration_seconds_bucket{le="10.0",check="db",component="",node="node-a"} 1
tocsin_check_duration_seconds_bucket{le="30.0",check="db",component="",node="node-a"} 1
tocsin_check_duration_seconds_bucket{le="60.0",check="db",component="",node="node-a"} 1
