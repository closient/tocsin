---
source: crates/tocsin/src/web/status_tests.rs
expression: normalize(&page)
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="referrer" content="same-origin">
<title>Example status</title>
<link rel="stylesheet" href="/static/<hash>/tocsin.css">
<link rel="alternate" type="application/atom+xml" title="Example status incidents" href="/feeds/incidents.atom">
<link rel="alternate" type="application/atom+xml" title="Example status releases" href="/feeds/releases.atom">
<meta name="description" content="Live status of Example&#39;s services.">
<meta name="htmx-config" content='{"includeIndicatorStyles":false,"allowEval":false,"allowScriptTags":false,"selfRequestsOnly":true,"historyCacheSize":0}'>
<script src="/static/<hash>/htmx.min.js" defer></script>
<script src="/static/<hash>/htmx-ext-sse.min.js" defer></script>
<script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"WebPage","description":"Live status of Example's services.","name":"Example status","url":"https://status.example.com/"},{"@type":"Event","description":"Looking into **Database upgrade**.","endDate":"<instant>","eventAttendanceMode":"https://schema.org/OnlineEventAttendanceMode","eventStatus":"https://schema.org/EventScheduled","location":{"@type":"VirtualLocation","url":"https://status.example.com/incidents/2"},"name":"Database upgrade","startDate":"<instant>","url":"https://status.example.com/incidents/2"},{"@type":"Event","description":"Looking into **Elevated API errors**.","eventAttendanceMode":"https://schema.org/OnlineEventAttendanceMode","eventStatus":"https://schema.org/EventScheduled","location":{"@type":"VirtualLocation","url":"https://status.example.com/incidents/1"},"name":"Elevated API errors","startDate":"<instant>","url":"https://status.example.com/incidents/1"}]}</script>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="site status">
  <a class="home" href="https://example.com/"><img class="logo" src="/brand/logo.svg" alt="Example"><span>Example status</span>
  </a>
  <nav aria-label="Example status links">
    <ul class="links">
      <li><a href="https://example.com/support">Support</a></li>
    </ul>
  </nav>
</header>
<main id="main">

<div class="intro">
<h1>Example status</h1>
<p class="lede">Live status of Example&#39;s services.</p>
</div>
<div class="live" hx-ext="sse" sse-connect="/api/v1/events">
<div id="banner" role="status" hx-get="/fragments/banner" hx-trigger="sse:component_changed, sse:incident_created, sse:incident_updated, sse:incident_edited, sse:resync, every 60s" hx-swap="innerHTML"><p class="hero down"><span class="hero-mark" aria-hidden="true">✕</span> <span class="hero-text">Some systems are down</span></p>
</div>
<section id="incidents" aria-labelledby="incidents-heading" hx-get="/fragments/incidents" hx-trigger="sse:incident_created, sse:incident_updated, sse:incident_edited, sse:resync, every 60s" hx-swap="innerHTML"><h2 id="incidents-heading">Active incidents and maintenance</h2>
<ul class="items surface"><li class="card">
  <a class="item-title" href="/incidents/2">Database upgrade</a>
  <div class="meta">
    <span class="badge scheduled">scheduled</span>
    <span class="badge maintenance">maintenance</span>
    <span class="muted">scheduled <when> IST to <when> IST · Jobs</span>
  </div>
  <div class="markdown"><p>Looking into <strong>Database upgrade</strong>.</p>
</div>
</li><li class="card">
  <a class="item-title" href="/incidents/1">Elevated API errors</a>
  <div class="meta">
    <span class="badge investigating">investigating</span>
    <span class="badge major">major impact</span>
    <span class="muted">started <time datetime="<instant>"><when> IST</time> · API</span>
  </div>
  <div class="markdown"><p>Looking into <strong>Elevated API errors</strong>.</p>
</div>
</li>
</ul>
</section>
<section id="components" aria-labelledby="components-heading" hx-get="/fragments/components" hx-trigger="sse:component_changed, sse:incident_created, sse:incident_updated, sse:incident_edited, sse:resync, every 60s" hx-swap="innerHTML"><h2 id="components-heading">Components</h2>
<div class="surface group">
  <ul class="components"><li class="component">
  <div class="component-line">
    <a class="name" href="/components/docs">Docs</a>
    <span class="status unknown"><span class="glyph" aria-hidden="true">?</span> Unknown</span>
  </div>
</li>
  </ul>
</div>
<div class="surface group">
  <div class="group-head">
    <h3>Edge</h3>
  </div>
  <ul class="components"><li class="component">
  <div class="component-line">
    <a class="name" href="/components/web">Web</a>
    <span class="status degraded"><span class="glyph" aria-hidden="true">▲</span> Degraded</span>
  </div>
</li>
  </ul>
</div>
<div class="surface group">
  <div class="group-head">
    <h3>Core</h3>
    <p class="muted">What everything else runs on</p>
  </div>
  <ul class="components"><li class="component">
  <div class="component-line">
    <a class="name" href="/components/jobs">Jobs</a>
    <span class="status operational"><span class="glyph" aria-hidden="true">✓</span> Operational</span>
  </div>
</li><li class="component">
  <div class="component-line">
    <a class="name" href="/components/api">API</a>
    <span class="status down"><span class="glyph" aria-hidden="true">✕</span> Down</span>
  </div>
  <p class="component-description">The public API</p>
</li>
  </ul>
</div>
</section>
<section id="uptime" aria-labelledby="uptime-heading" hx-get="/fragments/uptime" hx-trigger="sse:resync, every 600s" hx-swap="innerHTML"><h2 id="uptime-heading">Uptime, last 90 days</h2>
<p class="muted section-note">One mark per UTC day, today last; hover a day for its figure. Recomputed hourly.</p>
