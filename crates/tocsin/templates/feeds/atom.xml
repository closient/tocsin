{#- Every Atom feed (web/feeds.rs). askama escapes every value as XML
    text; an entry's content is HTML, escaped once more as its text. -#}
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <id>{{ id }}</id>
  <title>{{ title }}</title>
  {%- if let Some(subtitle) = subtitle %}
  <subtitle>{{ subtitle }}</subtitle>
  {%- endif %}
  <updated>{{ updated }}</updated>
  <link rel="self" type="application/atom+xml" href="{{ self_link }}"/>
  <link rel="alternate" type="text/html" href="{{ alternate }}"/>
  <author>
    <name>{{ author }}</name>
    {%- if let Some(uri) = author_uri %}
    <uri>{{ uri }}</uri>
    {%- endif %}
  </author>
  <generator uri="https://github.com/closient/tocsin" version="{{ version }}">tocsin</generator>
  {%- for entry in entries %}
  <entry>
    <id>{{ entry.id }}</id>
    <title>{{ entry.title }}</title>
    <link rel="alternate" type="text/html" href="{{ entry.link }}"/>
    <published>{{ entry.published }}</published>
    <updated>{{ entry.updated }}</updated>
    {%- for term in entry.categories %}
    <category term="{{ term }}"/>
    {%- endfor %}
    {%- if !entry.content_html.trim().is_empty() %}
    <content type="html">{{ entry.content_html }}</content>
    {%- endif %}
  </entry>
  {%- endfor %}
</feed>
