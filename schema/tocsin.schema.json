        "degraded_priority": {
          "default": 0,
          "description": "The priority of an alert that is degraded.",
          "format": "int8",
          "maximum": 127,
          "minimum": -128,
          "type": "integer"
        },
        "down_priority": {
          "default": 1,
          "description": "The Pushover priority, -2 to 2, of an alert that is down. 2 is an\nemergency, repeated until acknowledged and cancelled by the resolve.",
          "format": "int8",
          "maximum": 127,
          "minimum": -128,
          "type": "integer"
        },
        "resolved_priority": {
          "default": 0,
