  "description": "One configuration file. Every key is optional in a single file; rules\nthat span files (unique ids, references, required settings) are checked\nafter merging.\n\nThis is the type the JSON Schema describes.",
  "properties": {
    "check": {
      "description": "Probes run on an interval.",
      "items": {
        "$ref": "#/definitions/Check"
      },
      "type": "array"
    },
    "component": {
      "description": "What the status page shows, each with a health state.",
      "items": {
        "$ref": "#/definitions/Component"
      },
      "type": "array"
    },
    "group": {
      "description": "Headings that collect components on the status page.",
      "items": {
        "$ref": "#/definitions/Group"
      },
      "type": "array"
    },
    "heartbeat": {
      "description": "Pings tocsin expects to receive on an interval.",
      "items": {
        "$ref": "#/definitions/Heartbeat"
      },
      "type": "array"
    },
    "notifier": {
      "description": "Destinations for operator alerts.",
      "items": {
        "$ref": "#/definitions/Notifier"
      },
      "type": "array"
    },
    "page": {
      "anyOf": [
        {
          "$ref": "#/definitions/Page"
        },
        {
          "type": "null"
        }
      ],
      "description": "The public status page. At most one file may hold `[page]`."
    },
    "project": {
      "description": "Projects whose releases and deploys the release log records.",
      "items": {
        "$ref": "#/definitions/Project"
      },
      "type": "array"
    },
    "route": {
      "description": "Which alerts go to which notifiers.",
      "items": {
        "$ref": "#/definitions/Route"
      },
      "type": "array"
    },
    "server": {
      "anyOf": [
        {
          "$ref": "#/definitions/Server"
        },
        {
          "type": "null"
        }
      ],
      "description": "Server settings. At most one file may hold `[server]`."
    },
    "token": {
      "description": "Bearer tokens for the write API.",
      "items": {
        "$ref": "#/definitions/Token"
      },
      "type": "array"
    }
  },
  "title": "tocsin configuration file",
  "type": "object"
}
