    "RecordType": {
      "description": "A DNS record type.",
      "oneOf": [
        {
          "const": "A",
          "description": "IPv4 address.",
          "type": "string"
        },
        {
          "const": "AAAA",
          "description": "IPv6 address.",
          "type": "string"
        },
        {
          "const": "CNAME",
          "description": "Canonical name.",
          "type": "string"
        },
        {
          "const": "MX",
          "description": "Mail exchanger.",
          "type": "string"
        },
        {
          "const": "NS",
          "description": "Name server.",
          "type": "string"
        },
        {
          "const": "TXT",
          "description": "Text.",
          "type": "string"
        },
        {
          "const": "SRV",
          "description": "Service locator.",
          "type": "string"
        },
        {
          "const": "CAA",
          "description": "Certification authority authorization.",
          "type": "string"
        }
      ]
    },
    "RecordsAssertion": {
      "additionalProperties": false,
      "description": "A condition on the records a DNS lookup returns. Records are compared\nas text, ignoring a trailing `.` on names; CNAME, MX, NS and SRV\nrecords, which hold names, also ignore case.",
      "properties": {
        "contains": {
          "description": "One of the records equals this.",
          "type": [
            "string",
            "null"
          ]
