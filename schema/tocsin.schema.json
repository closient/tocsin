        },
        {
          "const": "discord",
          "description": "A Discord webhook.",
          "type": "string"
        },
        {
          "const": "telegram",
          "description": "A Telegram bot.",
          "type": "string"
        },
        {
          "const": "webhook",
          "description": "A generic JSON webhook.",
          "type": "string"
        },
        {
          "const": "alertmanager",
