{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "AlertmanagerSettings": {
      "additionalProperties": false,
      "description": "`[notifier.alertmanager]`.",
      "properties": {
        "bearer_token": {
          "anyOf": [
            {
              "$ref": "#/definitions/Secret"
            },
            {
              "type": "null"
            }
          ],
          "description": "Sent as `Authorization: Bearer ...`. Secret."
        },
        "url": {
          "description": "The Alertmanager base URL, such as `http://alertmanager:9093`.",
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "type": "object"
    },
    "Assertion": {
      "additionalProperties": false,
      "description": "One condition a probe result must meet, and the state a failure maps to.",
      "properties": {
        "banner": {
          "anyOf": [
            {
              "$ref": "#/definitions/TextAssertion"
            },
            {
              "type": "null"
            }
          ],
          "description": "The text a TCP server sends after connecting (and after `send`)."
        },
        "body": {
          "anyOf": [
            {
              "$ref": "#/definitions/TextAssertion"
            },
            {
              "type": "null"
            }
          ],
          "description": "The response body text."
        },
        "certificate_days_remaining": {
          "anyOf": [
            {
              "$ref": "#/definitions/Comparison"
            },
            {
              "type": "null"
            }
          ],
          "description": "Days until the server certificate expires."
        },
        "chain_valid": {
          "description": "Whether the server certificate chains to a trusted root and is\nwithin its validity period.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "header": {
          "anyOf": [
            {
              "$ref": "#/definitions/HeaderAssertion"
            },
            {
              "type": "null"
            }
          ],
          "description": "A response header."
        },
        "hostname_valid": {
          "description": "Whether the server certificate is valid for the host name checked.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "json": {
          "anyOf": [
            {
              "$ref": "#/definitions/JsonAssertion"
            },
            {
              "type": "null"
            }
          ],
          "description": "A value in the JSON response body."
        },
        "latency_ms": {
          "anyOf": [
            {
              "$ref": "#/definitions/Comparison"
            },
            {
              "type": "null"
            }
          ],
          "description": "The probe's latency, in milliseconds."
        },
        "on_fail": {
          "allOf": [
            {
              "$ref": "#/definitions/FailureState"
            }
          ],
          "default": "down",
          "description": "The state the check takes when this condition fails."
        },
        "records": {
          "anyOf": [
            {
              "$ref": "#/definitions/RecordsAssertion"
            },
            {
              "type": "null"
            }
          ],
          "description": "The records a DNS lookup returns."
        },
        "status": {
          "description": "The HTTP status is one of these.",
          "items": {
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Auth": {
      "additionalProperties": false,
      "description": "`[server.auth]`: how the admin page at `/admin/` learns who is asking.\n\ntocsin never handles passwords. It sits behind an identity-aware proxy\nand believes only what that proxy can prove: a signed Cloudflare Access\ntoken, or a header from a peer address you trust. Without this table,\nor with `mode = \"none\"`, the admin page does not exist.",
      "properties": {
        "allowed_domains": {
          "description": "Email domains allowed in, matched exactly (`example.com` does not\nadmit `team.example.com`).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "allowed_emails": {
          "description": "Email addresses allowed in. With neither this nor\n`allowed_domains`, everyone the proxy lets through is allowed.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "audience": {
          "description": "`cloudflare_access` only: the Access application's audience (AUD)\ntag.",
          "type": [
            "string",
            "null"
          ]
        },
        "header": {
          "description": "`trusted_header` only: the request header carrying the email\naddress. Defaults to `X-Forwarded-Email`.",
          "type": [
            "string",
            "null"
          ]
        },
        "mode": {
          "allOf": [
            {
              "$ref": "#/definitions/AuthMode"
            }
          ],
          "default": "none",
          "description": "How identities are proven. `none` turns the admin page off."
        },
        "team_domain": {
          "description": "`cloudflare_access` only: the Zero Trust team, as `name` or\n`name.cloudflareaccess.com`.",
          "type": [
            "string",
            "null"
          ]
        },
        "trusted_proxies": {
          "description": "`trusted_header` only: the networks the proxy connects from. The\nheader is believed only when the TCP peer is inside one of them;\n`X-Forwarded-For` is never consulted.",
          "items": {
            "$ref": "#/definitions/Cidr"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "AuthMode": {
      "description": "How [`Auth`] proves who is asking.",
      "oneOf": [
        {
          "const": "none",
          "description": "No admin page.",
          "type": "string"
        },
        {
          "const": "cloudflare_access",
          "description": "Cloudflare Access: verify the signed `Cf-Access-Jwt-Assertion`\ntoken against the team's published keys.",
          "type": "string"
        },
        {
          "const": "trusted_header",
          "description": "A proxy on a trusted network names the person in a header.",
          "type": "string"
        }
      ]
    },
    "BasicAuth": {
      "additionalProperties": false,
      "description": "`[check.http.basic_auth]`.",
      "properties": {
        "password": {
          "allOf": [
            {
              "$ref": "#/definitions/Secret"
            }
          ],
          "description": "The password. Secret."
        },
        "username": {
          "allOf": [
            {
              "$ref": "#/definitions/Text"
            }
          ],
          "description": "The user name. It may be a secret, `${ENV:NAME}`."
        }
      },
      "required": [
        "username",
        "password"
      ],
      "type": "object"
    },
    "Check": {
      "additionalProperties": false,
      "description": "A probe run on an interval, whose result sets a component's health.",
      "properties": {
        "assert": {
          "description": "Conditions a result must meet, each `[[check.assert]]` table holding\none. With none, a probe that completes counts as up, except that\n`http` needs a 2xx or 3xx status, `dns` a `NOERROR` response and\n`tls` a certificate that verifies for the host.",
          "items": {
            "$ref": "#/definitions/Assertion"
          },
          "type": "array"
        },
        "component": {
          "anyOf": [
            {
              "$ref": "#/definitions/Id"
            },
            {
              "type": "null"
            }
          ],
          "description": "The `[[component]]` whose health this check sets."
        },
        "confirm": {
          "default": 1,
          "description": "Consecutive results that disagree with the current state before the\nstate changes.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "dns": {
          "anyOf": [
            {
              "$ref": "#/definitions/DnsSettings"
            },
            {
              "type": "null"
            }
          ],
          "description": "Settings for `dns` checks."
        },
        "http": {
          "anyOf": [
            {
              "$ref": "#/definitions/HttpSettings"
            },
            {
              "type": "null"
            }
          ],
          "description": "Settings for `http` checks."
        },
        "id": {
          "allOf": [
            {
              "$ref": "#/definitions/Id"
            }
          ],
          "description": "Unique among checks and heartbeats in every file: they share one\nhistory."
        },
        "interval": {
          "allOf": [
            {
              "$ref": "#/definitions/Duration"
            }
          ],
          "default": "1m",
          "description": "How often the probe runs."
        },
        "link": {
          "description": "Links shown with the check, such as its dashboard or runbook, each a\n`[[check.link]]` table.",
          "items": {
            "$ref": "#/definitions/Link"
          },
          "type": "array"
        },
        "name": {
          "description": "Display name; the id is shown when it is absent.",
          "type": [
            "string",
            "null"
          ]
        },
        "target": {
          "description": "What is probed. Its form depends on the type: a URL for `http`,\n`host:port` for `tcp`, `host` or `host:port` for `tls`, a domain\nname for `dns` and a host for `icmp`.",
          "type": "string"
        },
        "tcp": {
          "anyOf": [
            {
              "$ref": "#/definitions/TcpSettings"
            },
            {
              "type": "null"
            }
          ],
          "description": "Settings for `tcp` checks."
        },
        "timeout": {
          "allOf": [
            {
              "$ref": "#/definitions/Duration"
            }
          ],
          "default": "10s",
          "description": "How long one probe may take before it counts as failed. Must be\nshorter than the interval."
        },
        "tls": {
          "anyOf": [
            {
              "$ref": "#/definitions/TlsSettings"
            },
            {
              "type": "null"
            }
          ],
          "description": "Settings for `tls` checks."
        },
        "type": {
          "allOf": [
            {
              "$ref": "#/definitions/CheckType"
            }
          ],
          "description": "Which probe runs."
        }
      },
      "required": [
        "id",
        "type",
        "target"
      ],
      "type": "object"
    },
    "CheckType": {
      "description": "The probe a check runs.",
      "oneOf": [
        {
          "const": "http",
          "description": "An HTTP or HTTPS request.",
          "type": "string"
        },
        {
          "const": "tcp",
          "description": "A TCP connection.",
          "type": "string"
        },
        {
          "const": "dns",
          "description": "A DNS lookup.",
          "type": "string"
        },
        {
          "const": "icmp",
          "description": "An ICMP echo (ping).",
          "type": "string"
        },
        {
          "const": "tls",
          "description": "A TLS handshake, inspecting the certificate.",
          "type": "string"
        }
      ]
    },
    "Cidr": {
      "description": "An IP network such as \"10.0.0.0/8\" or \"fd00::/8\", or a single address such as \"192.0.2.7\".",
      "type": "string"
    },
    "Comparison": {
      "additionalProperties": false,
      "description": "Numeric bounds; every bound given must hold.",
      "properties": {
        "eq": {
          "description": "Equal to.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "gt": {
          "description": "Greater than.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "gte": {
          "description": "Greater than or equal to.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "lt": {
          "description": "Less than.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "lte": {
          "description": "Less than or equal to.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Component": {
      "additionalProperties": false,
      "description": "`[[component]]`: something the status page shows with a health state.",
      "properties": {
        "description": {
          "description": "A line shown with the component.",
          "type": [
            "string",
            "null"
          ]
        },
        "group": {
          "anyOf": [
            {
              "$ref": "#/definitions/Id"
            },
            {
              "type": "null"
            }
          ],
          "description": "The `[[group]]` the component is shown under."
        },
        "id": {
          "allOf": [
            {
              "$ref": "#/definitions/Id"
            }
          ],
          "description": "Unique among components in every file."
        },
        "name": {
          "description": "Display name.",
          "type": "string"
        },
        "rule": {
          "allOf": [
            {
              "$ref": "#/definitions/ComponentRule"
            }
          ],
          "default": "worst",
          "description": "How the health of the component's checks combines into its own."
        }
      },
      "required": [
        "id",
        "name"
      ],
      "type": "object"
    },
    "ComponentRule": {
      "description": "How a component's health is derived from the health of its checks.",
      "oneOf": [
        {
          "const": "worst",
          "description": "The worst check decides: one check down makes the component down.",
          "type": "string"
        },
        {
          "const": "majority",
          "description": "The worst state that more than half of the checks share or exceed:\none check down out of three leaves the component up.",
          "type": "string"
        }
      ]
    },
    "DiscordSettings": {
      "additionalProperties": false,
      "description": "`[notifier.discord]`.",
      "properties": {
        "webhook_url": {
          "allOf": [
            {
              "$ref": "#/definitions/Secret"
            }
          ],
          "description": "The channel webhook URL. Secret."
        }
      },
      "required": [
        "webhook_url"
      ],
      "type": "object"
    },
    "DnsSettings": {
      "additionalProperties": false,
      "description": "`[check.dns]`.",
      "properties": {
        "record_type": {
          "allOf": [
            {
              "$ref": "#/definitions/RecordType"
            }
          ],
          "default": "A",
          "description": "The record type queried."
        },
        "resolver": {
          "description": "The resolver queried, as `ip` or `ip:port`; the system resolver when\nabsent.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Duration": {
      "description": "A duration such as \"500ms\", \"30s\", \"5m\", \"1h30m\" or \"1d\".",
      "pattern": "^([0-9]+(ms|s|m|h|d))+$",
      "type": "string"
    },
    "EmailSettings": {
      "additionalProperties": false,
      "description": "`[notifier.email]`.",
      "properties": {
        "to": {
          "description": "Recipient addresses.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "to"
      ],
      "type": "object"
    },
    "FailureState": {
      "description": "The state a failed assertion puts its check in.",
      "oneOf": [
        {
          "const": "degraded",
          "description": "Working, but worse than it should be.",
          "type": "string"
        },
        {
          "const": "down",
          "description": "Not working.",
          "type": "string"
        }
      ]
    },
    "Group": {
      "additionalProperties": false,
      "description": "`[[group]]`: a heading collecting components on the status page.",
      "properties": {
        "description": {
          "description": "A line shown under the heading.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "allOf": [
            {
              "$ref": "#/definitions/Id"
            }
          ],
          "description": "Unique among groups in every file."
        },
        "name": {
          "description": "Display name.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "type": "object"
    },
    "HeaderAssertion": {
      "additionalProperties": false,
      "description": "A condition on one response header.",
      "properties": {
        "contains": {
          "description": "A value of the header contains this.",
          "type": [
            "string",
            "null"
          ]
        },
        "eq": {
          "description": "A value of the header equals this.",
          "type": [
            "string",
            "null"
          ]
        },
        "exists": {
          "description": "Whether the header is present.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "name": {
          "description": "The header name, matched without regard to case.",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "Heartbeat": {
      "additionalProperties": false,
      "description": "`[[heartbeat]]`: a ping tocsin expects to receive, such as a cron job\nreporting in. Pings are sent to the write API with a token that has the\n`heartbeat` scope. A heartbeat with no ping for `interval + grace` is\ndown; it is a member of its component exactly as a check is.",
      "properties": {
        "component": {
          "anyOf": [
            {
              "$ref": "#/definitions/Id"
            },
            {
              "type": "null"
            }
          ],
          "description": "The `[[component]]` whose health this heartbeat sets."
        },
        "grace": {
          "allOf": [
            {
              "$ref": "#/definitions/Duration"
            }
          ],
          "default": "1m",
          "description": "How late a ping may be before the heartbeat is down: it is down once\n`interval + grace` passes without one."
        },
        "id": {
          "allOf": [
            {
              "$ref": "#/definitions/Id"
            }
          ],
          "description": "Unique among checks and heartbeats in every file: they share one\nhistory."
        },
        "interval": {
          "allOf": [
            {
              "$ref": "#/definitions/Duration"
            }
          ],
          "description": "How often a ping is expected."
        },
        "link": {
          "description": "Links shown with the heartbeat, such as the job's logs or runbook,\neach a `[[heartbeat.link]]` table.",
          "items": {
            "$ref": "#/definitions/Link"
          },
          "type": "array"
        },
        "name": {
          "description": "Display name; the id is shown when it is absent.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "interval"
      ],
      "type": "object"
    },
    "HttpMethod": {
      "description": "An HTTP request method.",
      "oneOf": [
        {
          "const": "GET",
          "description": "`GET`.",
          "type": "string"
        },
        {
          "const": "HEAD",
          "description": "`HEAD`.",
          "type": "string"
        },
        {
          "const": "POST",
          "description": "`POST`.",
          "type": "string"
        },
        {
          "const": "PUT",
          "description": "`PUT`.",
          "type": "string"
        },
        {
          "const": "PATCH",
          "description": "`PATCH`.",
          "type": "string"
        },
        {
          "const": "DELETE",
          "description": "`DELETE`.",
          "type": "string"
        },
        {
          "const": "OPTIONS",
          "description": "`OPTIONS`.",
          "type": "string"
        }
      ]
    },
    "HttpSettings": {
      "additionalProperties": false,
      "description": "`[check.http]`.",
      "properties": {
        "basic_auth": {
          "anyOf": [
            {
              "$ref": "#/definitions/BasicAuth"
            },
            {
              "type": "null"
            }
          ],
          "description": "Sent as HTTP basic authentication."
        },
        "bearer_token": {
          "anyOf": [
            {
              "$ref": "#/definitions/Secret"
            },
            {
              "type": "null"
            }
          ],
          "description": "Sent as `Authorization: Bearer <token>`. Secret."
        },
        "body": {
          "anyOf": [
            {
              "$ref": "#/definitions/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Request body. It may be a secret, `${ENV:NAME}`."
        },
        "follow_redirects": {
          "default": false,
          "description": "Whether redirects are followed; when not, a 3xx is the result.",
          "type": "boolean"
        },
        "headers": {
          "additionalProperties": {
            "$ref": "#/definitions/Text"
          },
          "description": "Request headers. A value may be a secret, `${ENV:NAME}`.",
          "type": "object"
        },
        "method": {
          "allOf": [
            {
              "$ref": "#/definitions/HttpMethod"
            }
          ],
          "default": "GET",
          "description": "Request method."
        },
        "server_name": {
          "description": "The host name sent as TLS SNI and `Host`, and checked against the\ncertificate, when it differs from the target's host. The target's\nhost is still the address connected to.",
          "type": [
            "string",
            "null"
          ]
        },
        "verify_certificate": {
          "default": true,
          "description": "Whether the server's certificate must verify. Defaults to true.\nWhen false, the request proceeds and the certificate is still\nreported, so `chain_valid` and `hostname_valid` can be asserted.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "Id": {
      "description": "A slug: lowercase letters, digits and hyphens, starting with a letter or digit.",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "type": "string"
    },
    "JsonAssertion": {
      "additionalProperties": false,
      "description": "A value selected from the JSON response body by an RFC 9535 JSON path.",
      "properties": {
        "contains": {
          "description": "The value is a string containing this.",
          "type": [
            "string",
            "null"
          ]
        },
        "eq": {
          "description": "The value equals this."
        },
        "exists": {
          "description": "Whether the path selects any value.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "ne": {
          "description": "The value does not equal this."
        },
        "path": {
          "description": "An RFC 9535 JSON path, such as `$.checks[0].status` or\n`$.components[?@.name=='API'].status`. When it selects several\nvalues, the first in document order is compared.",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "Link": {
      "additionalProperties": false,
      "description": "A `[[check.link]]` or `[[heartbeat.link]]`: a named link to somewhere an\noperator looks next, such as a dashboard, logs or a runbook.",
      "properties": {
        "name": {
          "description": "The link text.",
          "type": "string"
        },
        "url": {
          "description": "Where it goes: an absolute `http://` or `https://` URL.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "url"
      ],
      "type": "object"
    },
    "Notifier": {
      "additionalProperties": false,
      "description": "A destination for operator alerts. Every alert it sends is followed by\na resolve with the same identity.",
      "properties": {
        "alertmanager": {
          "anyOf": [
            {
              "$ref": "#/definitions/AlertmanagerSettings"
            },
            {
              "type": "null"
            }
          ],
          "description": "`[notifier.alertmanager]`."
        },
        "discord": {
          "anyOf": [
            {
              "$ref": "#/definitions/DiscordSettings"
            },
            {
              "type": "null"
            }
          ],
          "description": "`[notifier.discord]`."
        },
        "email": {
          "anyOf": [
            {
              "$ref": "#/definitions/EmailSettings"
            },
            {
              "type": "null"
            }
          ],
          "description": "`[notifier.email]`. Sender addresses come from `[server.email]`."
        },
        "id": {
          "allOf": [
            {
              "$ref": "#/definitions/Id"
            }
          ],
